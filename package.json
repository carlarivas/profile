{
	"name": "profile",
	"version": "1.0.0",
	"description": "Carla Rivas profile",
	"main": "index.html",
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"serve": "live-server",
		"compile:scss": "sass --source-map scss/main.scss css/main.comp.css",
		"prefix:css": "postcss --use autoprefixer -b \"defaults\" css/main.comp.css -o css/main.prefix.css",
		"compress:css": "sass --no-source-map --style=compressed css/main.prefix.css css/main.css",
		"build": "npm-run-all compile:scss prefix:css compress:css"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/carlarivas/profile.git"
	},
	"keywords": [
		"html",
		"css",
		"portfolio-template",
		"free-to-use"
	],
	"author": {
		"name": "Carla Rivas",
		"url": "https://carlarivas.github.io/profile/"
	},
	"license": "MIT",
	"devDependencies": {
		"autoprefixer": "^10.4.20",
		"live-server": "^1.2.2",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.4.49",
		"postcss-cli": "^11.0.0",
		"sass": "^1.80.6"
	},
	"homepage": "https://carlarivas.github.io/profile/"
}
